<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lite edition: no Android TV launcher-channel sync. Drop the boot-time
         process spin-up (BOOT_COMPLETED receiver) and the 15-min JobService.
         Channel-sync code is also gated off via AppFeaturePolicy.liteMode. -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />

    <!-- Lets the in-app updater install its own updates without a confirmation screen on Android 12+. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <receiver
            android:name=".core.sync.androidtv.TvChannelBootReceiver"
            tools:node="remove" />

        <service
            android:name=".core.sync.androidtv.TvChannelRefreshJobService"
            tools:node="remove" />

        <service
            android:name=".updater.UpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".updater.UpdateInstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
